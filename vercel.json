{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/js/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control",                "value": "public, max-age=31536000, immutable" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Access-Control-Allow-Origin",  "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin",             "destination": "/admin.html" },
    { "source": "/postuler",          "destination": "/postuler.html" },
    { "source": "/regularisation",    "destination": "/regularisation.html" },
    { "source": "/verifier",          "destination": "/verifier.html" },
    { "source": "/",                  "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/admin.html",            "destination": "/admin",            "permanent": true },
    { "source": "/postuler.html",         "destination": "/postuler",         "permanent": true },
    { "source": "/regularisation.html",   "destination": "/regularisation",   "permanent": true },
    { "source": "/verifier.html",         "destination": "/verifier",         "permanent": true }
  ]
}
